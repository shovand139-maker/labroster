<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>LabRoster.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!-- Scripts ship inside the assembly so the migrator runs the same SQL everywhere. -->
  <ItemGroup>
    <EmbeddedResource Include="../../db/migrations/*.sql" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../db/procedures/*.sql" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../db/seed/*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
